PORT=3000

# Clave para las acciones de administracion (recargar / subir Excel). Cabecera: x-admin-key
ADMIN_KEY=cambia-esta-clave

# Carpeta donde se guarda el Excel (usa un volumen en Railway, p. ej. /data)
DATA_DIR=./data

# --- Opcion A: leer el Excel directamente de SharePoint (Microsoft Graph, app registrada en Entra ID) ---
# Enlace del archivo tal como lo abre SharePoint (el de la barra de direcciones sirve)
SP_FILE_URL=https://airlinkdistribution.sharepoint.com/:x:/r/sites/AirlinkDR/_layouts/15/Doc.aspx?sourcedoc=%7B2056C02D-AB45-43D8-B5FA-E8C6F4144A4A%7D&file=Control_Deuda_Vacaciones.xlsb&action=default
# (opcional) ruta del archivo dentro de la biblioteca, si se conoce. Evita la busqueda por nombre.
# SP_FILE_PATH=Documentos compartidos/RRHH/Control_Deuda_Vacaciones.xlsb
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Cada cuantos minutos se vuelve a descargar el Excel (0 = solo al arrancar o con "Recargar")
REFRESH_MINUTES=10

# --- Opcion B: archivo local (sin SharePoint). Tambien se puede subir desde /admin.html ---
# DATA_FILE=./data/Control_Deuda_Vacaciones.xlsb
